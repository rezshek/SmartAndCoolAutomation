# Local development only. Never use these example credentials outside your machine.
DATABASE_URL=postgresql+psycopg://smartandcool:local-dev-only@127.0.0.1:54329/smartandcool
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_ATTEMPTS=3
# CLI checks require BOTH this flag and --live. No publisher/order APIs exist.
LIVE_CHECKS_ENABLED=false

CJ_API_KEY=
# Optional reusable token pair, with timezone-aware expiry values from CJ.
CJ_ACCESS_TOKEN=
CJ_ACCESS_TOKEN_EXPIRES_AT=
CJ_REFRESH_TOKEN=
CJ_REFRESH_TOKEN_EXPIRES_AT=

# Store root, including any WordPress subdirectory. HTTPS only; no credentials in URL.
WOO_BASE_URL=
# Create a separate Read-only key. Do not change the key used by the CJ connector.
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Populate only after private SP-API app registration and self-authorization.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
# No IAM keys or SigV4 configuration is required for SP-API.
